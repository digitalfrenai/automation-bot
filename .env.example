# Local: SQLite next to schema (prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Production (Docker/Railway volume): persist DB on mounted disk
# DATABASE_URL="file:/data/prisma/prod.db"
# UPLOAD_THEMES_DIR="/data/uploads/themes"
# UPLOAD_LOGOS_DIR="/data/uploads/logos"
# UPLOAD_DESIGN_REFERENCES_DIR="/data/uploads/design-references"

# Optional — xAI chat model (default: grok-4.6)
# XAI_MODEL="grok-4.6"

# Optional — Grok HTTP timeout in ms (default: 900000 = 15 min)
# XAI_TIMEOUT_MS="900000"

# Optional — max reference website screenshots for Grok vision (default: 6)
# DESIGN_REFERENCE_MAX="6"

# Optional — compress reference screenshots before Grok vision (xAI payload limits)
# DESIGN_REFERENCE_VISION_MAX_WIDTH="1400"
# DESIGN_REFERENCE_VISION_MAX_BYTES="450000"
# DESIGN_REFERENCE_VISION_TOTAL_BYTES="2400000"

# XAI_IMAGE_MODEL="grok-imagine-image"

# Optional — set to false to skip page image handling during Phase 2
# PAGE_IMAGES_ENABLED="true"
# PAGE_IMAGES_MAX_PER_PAGE="16"

# Windows: if `npm install` warns about Prisma EPERM, stop `npm run dev` and run `npx prisma generate`.

# Optional — max site header logo size in px (default 280×72)
# LOGO_MAX_WIDTH="280"
# LOGO_MAX_HEIGHT="72"

# Optional — set to false to disable Grok Imagine when theme demo assets are missing (default: on)
# PAGE_IMAGES_AI="true"
# Reject Grok Imagine images that contain visible text (vision check + up to 3 retries). Default: on.
# GROK_IMAGE_TEXT_CHECK="true"
# GROK_IMAGE_TEXT_MAX_ATTEMPTS="3"

# Optional — use raw <figure> HTML instead of wp:image blocks (not recommended on Kadence/block themes)
# PAGE_IMAGES_HTML_FIGURES="false"

# Optional — force page content format: html | gutenberg | elementor | divi
# Kadence sites default to gutenberg automatically when Elementor is only installed as a plugin.
# CONTENT_FORMAT="gutenberg"
